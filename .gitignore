# Cache local du scraper (régénérable, volumineux)
data/.cache/
# Les fiches de poste transmises par la DCIP ne sont PAS publiées : ce dépôt
# est public, et ces documents portent des informations internes que
# l'application n'affiche pas — cotation IFSE, astreintes, rattachement
# hiérarchique, numéro de vacance — ainsi que le nom de l'agent qui les a
# rédigées dans leurs propriétés. Seul le contenu extrait vers
# data/postes-dcip.json est destiné à être vu.
sources/fiches-dcip/

# Secrets — ne JAMAIS versionner
.env
*.key
*.pem
secrets.json
# Systèmes
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
# Sortie du générateur de maquettes (régénérable par `node design/generer.mjs`)
design/sortie/
design/apercu/
design/ctrl/
design/mes/
design/captures/
# Classeur du registre : jamais sur GitHub (il reçoit des données personnelles)
local/
# Dépendances de la recette (installées à la demande, cf. scripts/recette/LISEZMOI.md)
node_modules/
package.json
package-lock.json
# Captures produites par la recette
app-postes-*.png
app-quiz-*.png
# Rapport produit par scripts/recette/audit-a11y.mjs
audit-a11y.json
